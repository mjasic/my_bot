<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
    RPLidar A1 na szczycie masztu. Ramka laser_frame = plaszczyzna skanowania,
    0.450 m nad podlozem, 0.210 m za osia kol. Podstawa lidara jest na szczycie
    masztu (0.415 m), wiec wizualnie walec ma srodek 0.0175 m ponizej ramki.
    Obrot yaw = 3.14159 zostawiony jak w poprzedniej wersji (lidar montowany "tylem").
    -->

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_frame"/>
        <origin xyz="-0.210 0 0.450" rpy="0 0 3.14159"/>
    </joint>

    <link name="laser_frame">

        <visual>
            <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.036" length="0.035"/>
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.036" length="0.035"/>
            </geometry>
        </collision>

        <xacro:inertial_cylinder mass="0.17" length="0.035" radius="0.036">
            <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
        </xacro:inertial_cylinder>

    </link>

    <gazebo reference="laser_frame">

        <sensor name="laser" type="gpu_lidar">

            <gz_frame_id>laser_frame</gz_frame_id>

            <pose>0 0 0 0 0 0</pose>

            <update_rate>5.5</update_rate>

            <topic>scan</topic>

            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>

                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>

                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>

            <always_on>true</always_on>
            <visualize>true</visualize>

        </sensor>

    </gazebo>

</robot>