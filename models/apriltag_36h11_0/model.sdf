<?xml version="1.0"?>
<sdf version="1.9">
  <model name="apriltag_36h11_0">
    <static>true</static>

    <!--
      Tag stoi pionowo: cienki wymiar wzdłuż lokalnej osi X (0.005 m),
      a płaszczyzna tagu 0.08 x 0.08 m leży w płaszczyźnie Y-Z.
      Normalna widocznej strony tagu (z teksturą) wskazuje w kierunku +X.
      Robot powinien podjeżdżać od strony +X, patrząc w stronę -X (na tag).
    -->
    <link name="tag_link">
      <visual name="tag_visual">
        <geometry>
          <box>
            <size>0.005 0.08 0.08</size>
          </box>
        </geometry>
        <material>
   	 <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/tag36_11_00000_400.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="tag_collision">
        <geometry>
          <box>
            <size>0.005 0.08 0.08</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
