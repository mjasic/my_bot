From: mjasic <jasicmarcinn@gmail.com>
Date: Wed, 11 Nov 2026 12:33:17 +0100
Subject: [PATCH] Dodano sterowanie podnosnikiem przez /lift_cmd

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J33gXyx67rhreRzqstPWPn
---
 CMakeLists.txt                                |  1 +
 hardware/diffbot_system.cpp                   | 53 +++++++++++++++++++
 .../diffdrive_arduino/arduino_comms.hpp       |  8 +++
 .../diffdrive_arduino/diffbot_system.hpp      | 20 +++++++
 package.xml                                   |  1 +
 5 files changed, 83 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6fd99d3..96291ad 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,6 +11,7 @@ set(THIS_PACKAGE_INCLUDE_DEPENDS
   pluginlib
   rclcpp
   rclcpp_lifecycle
+  std_msgs
 )
 
 # find dependencies
diff --git a/hardware/diffbot_system.cpp b/hardware/diffbot_system.cpp
index 52c343d..354bbd8 100644
--- a/hardware/diffbot_system.cpp
+++ b/hardware/diffbot_system.cpp
@@ -23,6 +23,16 @@
 #include "hardware_interface/types/hardware_interface_type_values.hpp"
 #include "rclcpp/rclcpp.hpp"
 
+namespace
+{
+long long now_ms()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+           std::chrono::steady_clock::now().time_since_epoch())
+    .count();
+}
+}  // namespace
+
 namespace diffdrive_arduino
 {
 hardware_interface::CallbackReturn DiffDriveArduinoHardware::on_init(
@@ -182,6 +192,24 @@ hardware_interface::CallbackReturn DiffDriveArduinoHardware::on_activate(
   {
     comms_.set_pid_values(cfg_.pid_p,cfg_.pid_d,cfg_.pid_i,cfg_.pid_o);
   }
+  // Podnosnik: subskrypcja /lift_cmd w osobnym watku (port szeregowy dotyka tylko write()).
+  lift_pwm_ = 0;
+  lift_sent_ = 0;
+  lift_node_ = std::make_shared<rclcpp::Node>("diffdrive_lift");
+  lift_sub_ = lift_node_->create_subscription<std_msgs::msg::Int16>(
+    "/lift_cmd", 10,
+    [this](const std_msgs::msg::Int16::SharedPtr msg)
+    {
+      int v = msg->data;
+      if (v > 255) { v = 255; }
+      if (v < -255) { v = -255; }
+      lift_pwm_ = v;
+      lift_last_rx_ms_ = now_ms();
+    });
+  lift_exec_ = std::make_shared<rclcpp::executors::SingleThreadedExecutor>();
+  lift_exec_->add_node(lift_node_);
+  lift_thread_ = std::thread([this]() { lift_exec_->spin(); });
+
   RCLCPP_INFO(rclcpp::get_logger("DiffDriveArduinoHardware"), "Successfully activated!");
 
   return hardware_interface::CallbackReturn::SUCCESS;
@@ -191,6 +219,17 @@ hardware_interface::CallbackReturn DiffDriveArduinoHardware::on_deactivate(
   const rclcpp_lifecycle::State & /*previous_state*/)
 {
   RCLCPP_INFO(rclcpp::get_logger("DiffDriveArduinoHardware"), "Deactivating ...please wait...");
+  if (lift_exec_) { lift_exec_->cancel(); }
+  if (lift_thread_.joinable()) { lift_thread_.join(); }
+  lift_sub_.reset();
+  lift_exec_.reset();
+  lift_node_.reset();
+  lift_pwm_ = 0;
+  if (comms_.connected())
+  {
+    comms_.set_lift(0);
+  }
+  lift_sent_ = 0;
   RCLCPP_INFO(rclcpp::get_logger("DiffDriveArduinoHardware"), "Successfully deactivated!");
 
   return hardware_interface::CallbackReturn::SUCCESS;
@@ -230,6 +269,20 @@ hardware_interface::return_type diffdrive_arduino ::DiffDriveArduinoHardware::wr
   int motor_l_counts_per_loop = wheel_l_.cmd / wheel_l_.rads_per_count / cfg_.loop_rate;
   int motor_r_counts_per_loop = wheel_r_.cmd / wheel_r_.rads_per_count / cfg_.loop_rate;
   comms_.set_motor_values(motor_l_counts_per_loop, motor_r_counts_per_loop);
+
+  // Podnosnik: wysylamy 'l <pwm>' w kazdym cyklu, dopoki komenda jest niezerowa
+  // i swieza (< 500 ms); po zakonczeniu jeszcze raz 'l 0'.
+  int lift_target = lift_pwm_.load();
+  if (lift_target != 0 && now_ms() - lift_last_rx_ms_.load() > 500)
+  {
+    lift_target = 0;
+    lift_pwm_ = 0;
+  }
+  if (lift_target != 0 || lift_sent_ != 0)
+  {
+    comms_.set_lift(lift_target);
+    lift_sent_ = lift_target;
+  }
   return hardware_interface::return_type::OK;
 }
 
diff --git a/hardware/include/diffdrive_arduino/arduino_comms.hpp b/hardware/include/diffdrive_arduino/arduino_comms.hpp
index 58a511a..5e1038c 100644
--- a/hardware/include/diffdrive_arduino/arduino_comms.hpp
+++ b/hardware/include/diffdrive_arduino/arduino_comms.hpp
@@ -110,6 +110,14 @@ public:
     send_msg(ss.str());
   }
 
+  void set_lift(int pwm)
+  {
+    // lift_cmd: podnosnik, PWM -255..255 (dodatni = gora, 0 = stop)
+    std::stringstream ss;
+    ss << "l " << pwm << "\r";
+    send_msg(ss.str());
+  }
+
 private:
     LibSerial::SerialPort serial_conn_;
     int timeout_ms_;
diff --git a/hardware/include/diffdrive_arduino/diffbot_system.hpp b/hardware/include/diffdrive_arduino/diffbot_system.hpp
index f87067a..7ced134 100644
--- a/hardware/include/diffdrive_arduino/diffbot_system.hpp
+++ b/hardware/include/diffdrive_arduino/diffbot_system.hpp
@@ -15,8 +15,10 @@
 #ifndef DIFFDRIVE_ARDUINO__DIFFBOT_SYSTEM_HPP_
 #define DIFFDRIVE_ARDUINO__DIFFBOT_SYSTEM_HPP_
 
+#include <atomic>
 #include <memory>
 #include <string>
+#include <thread>
 #include <vector>
 
 #include "hardware_interface/handle.hpp"
@@ -25,7 +27,10 @@
 #include "hardware_interface/types/hardware_interface_return_values.hpp"
 #include "rclcpp/clock.hpp"
 #include "rclcpp/duration.hpp"
+#include "rclcpp/executors/single_threaded_executor.hpp"
 #include "rclcpp/macros.hpp"
+#include "rclcpp/node.hpp"
+#include "std_msgs/msg/int16.hpp"
 #include "rclcpp/time.hpp"
 #include "rclcpp_lifecycle/node_interfaces/lifecycle_node_interface.hpp"
 #include "rclcpp_lifecycle/state.hpp"
@@ -58,6 +63,12 @@ struct Config
 public:
   RCLCPP_SHARED_PTR_DEFINITIONS(DiffDriveArduinoHardware);
 
+  ~DiffDriveArduinoHardware() override
+  {
+    if (lift_exec_) { lift_exec_->cancel(); }
+    if (lift_thread_.joinable()) { lift_thread_.join(); }
+  }
+
   DIFFDRIVE_ARDUINO_PUBLIC
   hardware_interface::CallbackReturn on_init(
     const hardware_interface::HardwareInfo & info) override;
@@ -99,6 +110,15 @@ private:
   Config cfg_;
   Wheel wheel_l_;
   Wheel wheel_r_;
+
+  // Podnosnik: temat /lift_cmd (std_msgs/Int16, PWM -255..255)
+  rclcpp::Node::SharedPtr lift_node_;
+  rclcpp::Subscription<std_msgs::msg::Int16>::SharedPtr lift_sub_;
+  std::shared_ptr<rclcpp::executors::SingleThreadedExecutor> lift_exec_;
+  std::thread lift_thread_;
+  std::atomic<int> lift_pwm_{0};
+  std::atomic<long long> lift_last_rx_ms_{0};
+  int lift_sent_ = 0;
 };
 
 }  // namespace diffdrive_arduino
diff --git a/package.xml b/package.xml
index fd003d4..934461b 100644
--- a/package.xml
+++ b/package.xml
@@ -19,6 +19,7 @@
   <depend>pluginlib</depend>
   <depend>rclcpp</depend>
   <depend>rclcpp_lifecycle</depend>
+  <depend>std_msgs</depend>
   <depend>libserial-dev</depend>
 
   <exec_depend>ros2_controllers_test_nodes</exec_depend>
